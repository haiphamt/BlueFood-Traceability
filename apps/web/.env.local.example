NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Blockchain / Polygon ──────────────────────────────────────────────────────
# RPC endpoint — use Alchemy/Infura/QuickNode for production
POLYGON_RPC_URL=https://rpc-mumbai.maticvigil.com
# Private key of the wallet that holds SUBMITTER_ROLE on the contract
BLOCKCHAIN_SUBMITTER_PRIVATE_KEY=0x...your_private_key_here
# Deployed BatchRegistry contract address (output of deploy script)
CONTRACT_ADDRESS=0x...deployed_contract_address
# Explorer base URL (use https://mumbai.polygonscan.com for testnet)
NEXT_PUBLIC_POLYGONSCAN_BASE_URL=https://polygonscan.com

# ── Redis (Bull MQ queue) ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Webhook secrets ──────────────────────────────────────────────────────────
# Shared secret between Supabase Edge Function and the anchor API route
ANCHOR_WEBHOOK_SECRET=change-me-to-a-random-secret
# Shared secret between Supabase webhook trigger and the Edge Function
SUPABASE_WEBHOOK_SECRET=change-me-to-another-random-secret

# ── Slack notifications (optional) ──────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
