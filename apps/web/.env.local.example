NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=https://your-bluefood.vercel.app

# Blockchain / Polygon, optional for normal web + mobile demo.
POLYGON_RPC_URL=https://your-rpc-url
BLOCKCHAIN_SUBMITTER_PRIVATE_KEY=0x...your_private_key_here
CONTRACT_ADDRESS=0x...deployed_contract_address
NEXT_PUBLIC_POLYGONSCAN_BASE_URL=https://amoy.polygonscan.com

# Redis queue, optional unless running blockchain anchor worker.
REDIS_URL=rediss://your-redis-url

# Webhook secrets, optional unless using Supabase Edge Function anchor flow.
ANCHOR_WEBHOOK_SECRET=change-me-to-a-random-secret
SUPABASE_WEBHOOK_SECRET=change-me-to-another-random-secret

# Optional notifications.
SLACK_WEBHOOK_URL=
